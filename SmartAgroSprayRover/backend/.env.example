# Gemini 2.5 Flash API configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta2/models

# Sarvam AI speech configuration
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_BASE_URL=https://api.sarvam.ai/v1

# Optional Firebase service account JSON for chat history storage
FIREBASE_SERVICE_ACCOUNT_JSON=C:/path/to/serviceAccount.json
FIRESTORE_CHAT_COLLECTION=farmer_assistant_chats
